<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_call_notification"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/notifCallerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/caller_name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#212121" />

            <TextView
                android:id="@+id/notifCallSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notification_title"
                android:textSize="13sp"
                android:textColor="#616161" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Use explicit class name to avoid MaterialButton inflation in RemoteViews -->
        <android.widget.Button
            android:id="@+id/btnDecline"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/action_decline"
            android:textColor="#FFFFFF"
            android:background="#7B1FA2"
            android:layout_marginEnd="6dp" />

        <android.widget.Button
            android:id="@+id/btnAnswer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/action_answer"
            android:textColor="#FFFFFF"
            android:background="#1565C0"
            android:layout_marginStart="6dp" />

    </LinearLayout>
</LinearLayout>
